# Supabase (wajib)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Dipakai hanya oleh skrip seed (opsional, tapi disarankan agar bisa insert ke user lain)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# AI Advisor — pilih satu provider.
# Nilai AI_PROVIDER: gemini | openai | anthropic
# "openai" juga bisa dipakai untuk endpoint OpenAI-compatible (DashScope/Qwen) lewat AI_BASE_URL.
AI_PROVIDER=gemini
AI_API_KEY=<api-key>
# Opsional — override model default (gemini-2.5-flash / gpt-4o-mini / claude-sonnet-4-5)
# AI_MODEL=
# Opsional — custom base URL, mis. https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# AI_BASE_URL=

# Token untuk menjalankan `supabase link` / `supabase db push` ke project Cloud
# SUPABASE_ACCESS_TOKEN=
